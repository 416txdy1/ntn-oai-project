* text=auto
*.sh text eol=lf
*.py text eol=lf
*.m text eol=lf
*.c text eol=lf
*.h text eol=lf
*.cpp text eol=lf
*.tar.gz binary
*.cf32 binary
*.f32 binary
*.f64 binary
# Preserve upstream source, license and patch context formatting.
vendor/*LICENSE* -whitespace
oai_patch/current/** -whitespace
quadriga/oai/*.diff -whitespace

# Existing bundle provenance hashes the original Windows-generated trace bytes.
examples/fdd-pass/trace.csv text eol=crlf

# Restored handover input bytes remain reproducible on Windows and Linux.
local_ntn/satellite_schedule*.csv text eol=lf
local_ntn/stk_trace_firsthandover.csv text eol=lf
local_ntn/stk_trace_seamless.csv text eol=lf

# Completion and manifest hashes are independent of host text conventions.
examples/handover/**/*.json text eol=lf
examples/handover-miso4/**/*.json -text -whitespace
# Preserve the saved STK scenario bytes, including non-code .c chain files.
STK_LEO_Constellation_20260923_train_v2/** -text -whitespace
# Generated JSON is hash-bound by antenna.json; preserve exported bytes on every OS.
examples/fdd-pass-array/**/*.json -text -whitespace
examples/fdd-miso*/**/*.json -text -whitespace
