{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ntn-oai:qdchannel1:schema:1",
  "title": "QDCHANNEL1 manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "byte_order",
    "axes",
    "dimensions",
    "radio",
    "time",
    "composition",
    "provenance",
    "files"
  ],
  "properties": {
    "format": { "const": "QDCHANNEL1" },
    "schema_version": { "const": 1 },
    "byte_order": { "const": "little" },
    "axes": {
      "const": ["snapshot", "rx", "tx", "path"]
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshots", "rx_antennas", "tx_antennas", "paths"],
      "properties": {
        "snapshots": { "type": "integer", "minimum": 2 },
        "rx_antennas": { "type": "integer", "minimum": 1 },
        "tx_antennas": { "type": "integer", "minimum": 1 },
        "paths": { "type": "integer", "minimum": 1 }
      }
    },
    "radio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center_frequency_hz"],
      "properties": {
        "center_frequency_hz": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate", "interpolation", "out_of_range"],
      "properties": {
        "coordinate": { "const": "stk_trace_seconds" },
        "interpolation": { "const": "linear_complex_and_delay" },
        "out_of_range": { "const": "mute" }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bulk_delay_source",
        "bulk_doppler_source",
        "absolute_gain_source",
        "quadriga_delay",
        "quadriga_coefficients",
        "quadriga_large_scale_gain"
      ],
      "properties": {
        "bulk_delay_source": { "const": "STKTRACE2" },
        "bulk_doppler_source": { "const": "STKTRACE2" },
        "absolute_gain_source": { "const": "STKTRACE2" },
        "quadriga_delay": { "const": "relative_excess_seconds" },
        "quadriga_coefficients": { "const": "unit_snapshot_link_power" },
        "quadriga_large_scale_gain": { "const": "zero_mean_residual_db" }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quadriga_version", "scenario", "random_seed", "stk_trace_sha256"],
      "properties": {
        "quadriga_version": { "type": "string", "minLength": 1 },
        "scenario": { "type": "string", "minLength": 1 },
        "random_seed": { "type": "integer", "minimum": 0 },
        "stk_trace_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": false,
      "required": ["times", "delays", "coefficients", "residual_gain_db"],
      "properties": {
        "times": { "$ref": "#/$defs/file" },
        "delays": { "$ref": "#/$defs/file" },
        "coefficients": { "$ref": "#/$defs/file" },
        "residual_gain_db": { "$ref": "#/$defs/file" }
      }
    }
  },
  "$defs": {
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "dtype", "count", "bytes", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "dtype": { "enum": ["float64", "float32", "complex64_interleaved"] },
        "count": { "type": "integer", "minimum": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
